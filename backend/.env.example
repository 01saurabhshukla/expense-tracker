# Copy this file to .env and fill in real values. Never commit .env.

# Supabase Postgres connection string (Project → Connect).
# Use the Transaction pooler (port 6543, IPv4): many short connections are
# fine there. The direct host is IPv6-only; the Session pooler (port 5432)
# allows only 15 connections in total, which the test suite exceeds.
DATABASE_URL=

# Connections per process (default 10). With the Session pooler keep
# API + worker together under 15, e.g. 8 and 5.
# DB_POOL_MAX=10

# Supabase's CA certificate, so the app checks it's really talking to
# Supabase (Dashboard → Database → SSL Configuration → Download certificate).
# Required in production; without it in dev the connection is encrypted but
# the server isn't verified.
# DATABASE_CA_CERT=certs/supabase-ca.crt

# Port the backend listens on (defaults to 4000).
PORT=4000

# Secret for signing access tokens (min 32 chars). Generate with:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
# development | test | production. Must be "production" on EC2: it turns on
# the Secure flag for the refresh cookie (sent over HTTPS only).
NODE_ENV=development

# Where uploaded files are stored (default: backend/storage). Git-ignored.
# UPLOAD_DIR=
# Max upload size in bytes (default 10 MB).
# UPLOAD_MAX_BYTES=10485760

# Background jobs (BullMQ). Redis must use maxmemory-policy noeviction and,
# without a password, listen only on 127.0.0.1.
# REDIS_URL=redis://127.0.0.1:6379
# QUEUE_PREFIX=expense
# WORKER_CONCURRENCY=2
# JOB_ATTEMPTS=3
# JOB_BACKOFF_MS=2000

# Browser origins allowed to call the API, comma-separated, exact
# (scheme + host + port). Required in production; defaults to the Vite dev
# server (http://localhost:5173) otherwise.
# CORS_ORIGINS=https://app.example.com

# Proxy in front of the API, for the client's real IP (rate limiting, logs).
# EC2 with nginx on the same machine: loopback. Local dev: false (default).
# Required in production.
# TRUST_PROXY=loopback
