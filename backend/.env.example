# Copy this file to .env and fill in real values. Never commit .env.

# Supabase Postgres connection string (Project → Connect).
# Local dev: direct connection. Deployed: session/transaction pooler.
DATABASE_URL=

# Port the backend listens on (defaults to 4000).
PORT=4000

# Secret for signing access tokens (min 32 chars). Generate with:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
# development | test | production. Must be "production" on EC2: it turns on
# the Secure flag for the refresh cookie (sent over HTTPS only).
NODE_ENV=development
