# /etc/nginx/sites-available/expense-api  (docs/DEPLOYMENT.md, step 7)
# certbot --nginx -d api.example.com adds the HTTPS (listen 443 ssl) parts.
server {
    listen 80;
    server_name api.example.com;

    # Uploads are capped at 10 MB by the app; refuse anything bigger here,
    # before it reaches Node (T36).
    client_max_body_size 11m;

    location / {
        proxy_pass http://127.0.0.1:4000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Stream uploads to Node as they arrive instead of buffering them.
        proxy_request_buffering off;
        # Slow mobile uploads and long CSV/PDF exports.
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }
}
